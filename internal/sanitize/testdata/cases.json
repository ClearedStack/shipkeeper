[
  {"rule": "nothing to remove", "in": "Scaled up replica set example-app-6c9d7f5b8 to 2", "out": "Scaled up replica set example-app-6c9d7f5b8 to 2"},
  {"rule": "empty text", "in": "", "out": ""},

  {"rule": "known node name", "in": "Successfully assigned to worker-node-07", "out": "Successfully assigned to [node]"},
  {"rule": "known node name, longest first", "in": "node worker-node-07.rack3.example.internal is not ready", "out": "node [node] is not ready"},
  {"rule": "known node name, any letter case", "in": "Node WORKER-NODE-07 not ready", "out": "Node [node] not ready"},
  {"rule": "known node name inside a longer word is still removed", "in": "taint on n1x", "out": "taint on [node]x"},
  {"rule": "known pod name", "in": "Created pod: example-app-6c9d7f5b8-q4zt2", "out": "Created pod: pod-1"},
  {"rule": "known pod name with namespace and uid", "in": "pod=example-app-6c9d7f5b8-h8kxw_cs-workers(0f0e)", "out": "pod=pod-2_cs-workers(0f0e)"},
  {"rule": "known pod host name", "in": "host custom-hostname did not answer", "out": "host pod-2 did not answer"},
  {"rule": "known address of an unusual shape", "in": "peer not-an-address-shape closed", "out": "peer [address] closed"},

  {"rule": "service DNS name, full", "in": "lookup example-app.cs-workers.svc.cluster.local: no such host", "out": "lookup [internal-name]: no such host"},
  {"rule": "service DNS name with port and path", "in": "pull lazarette.clearedstack.svc.cluster.local:5000/example-app failed", "out": "pull [internal-name]:5000/example-app failed"},
  {"rule": "service DNS name, short svc form", "in": "dial example-app.cs-workers.svc", "out": "dial [internal-name]"},
  {"rule": "service DNS name, name.namespace form", "in": "GET http://muster.clearedstack/healthz", "out": "GET http://[internal-name]/healthz"},
  {"rule": "pod DNS name", "in": "10-42-3-18.cs-workers.pod.cluster.local refused", "out": "[internal-name] refused"},
  {"rule": "any name under the cluster domain", "in": "resolver kube-dns.cluster.local.", "out": "resolver [internal-name]."},
  {"rule": "DNS name in upper case", "in": "EXAMPLE-APP.CS-WORKERS.SVC.CLUSTER.LOCAL", "out": "[internal-name]"},
  {"rule": "node name followed by the cluster domain", "in": "worker-node-07.cluster.local", "out": "[internal-name]"},
  {"rule": "public host name is kept", "in": "see https://clearedstack.com/platform/operations/", "out": "see https://clearedstack.com/platform/operations/"},
  {"rule": "public host name with a namespace word in it is kept", "in": "www.clearedstack.com", "out": "www.clearedstack.com"},
  {"rule": "namespace/name is not a DNS name", "in": "assigned cs-workers/example-app", "out": "assigned cs-workers/example-app"},
  {"rule": "version number is kept", "in": "kubelet v1.31.0 started", "out": "kubelet v1.31.0 started"},

  {"rule": "IPv4 address", "in": "dial tcp 10.42.1.9: i/o timeout", "out": "dial tcp [address]: i/o timeout"},
  {"rule": "IPv4 address with port", "in": "dial tcp 10.42.1.9:8080: connect: connection refused", "out": "dial tcp [address]:8080: connect: connection refused"},
  {"rule": "IPv4 address in a URL", "in": "Get \"http://10.42.1.9:8080/healthz\"", "out": "Get \"http://[address]:8080/healthz\""},
  {"rule": "IPv4 range", "in": "no route to 10.42.0.0/16", "out": "no route to [address]"},
  {"rule": "IPv4 address at the end of a sentence", "in": "The peer was 192.168.7.20.", "out": "The peer was [address]."},
  {"rule": "several addresses", "in": "from 10.0.0.1 to 10.0.0.2", "out": "from [address] to [address]"},
  {"rule": "four dotted numbers are removed even if not an address", "in": "build 999.1.2.3", "out": "build [address]"},

  {"rule": "IPv6 address", "in": "dial tcp fd00:42:1::9: timeout", "out": "dial tcp [address]: timeout"},
  {"rule": "IPv6 address in brackets with port", "in": "dial tcp [fd00:42:1::9]:8080: refused", "out": "dial tcp [[address]]:8080: refused"},
  {"rule": "IPv6 address, full form", "in": "peer 2001:0db8:0000:0000:0000:0000:0000:0001 gone", "out": "peer [address] gone"},
  {"rule": "IPv6 loopback", "in": "listening on ::1", "out": "listening on [address]"},
  {"rule": "IPv6 address after a label and colon", "in": "addr:fd00::1", "out": "addr:[address]"},
  {"rule": "IPv6 range", "in": "pod range fd00:42::/48 is full", "out": "pod range [address] is full"},
  {"rule": "IPv6 address at the end of a sentence", "in": "The peer was fd00::7.", "out": "The peer was [address]."},
  {"rule": "IPv4-mapped IPv6 address", "in": "from ::ffff:10.0.0.1", "out": "from [address]"},
  {"rule": "a time of day is kept", "in": "started at 12:30:45", "out": "started at 12:30:45"},
  {"rule": "a hardware address is kept", "in": "link aa:bb:cc:dd:ee:ff up", "out": "link aa:bb:cc:dd:ee:ff up"}
]
