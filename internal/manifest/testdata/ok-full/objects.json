{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "shipkeeper",
      "app.kubernetes.io/name": "example-app"
    },
    "name": "example-app",
    "namespace": "cs-workers"
  },
  "spec": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "clearedstack"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "muster"
              }
            }
          },
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "cs-workers"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "other-app"
              }
            }
          }
        ],
        "ports": [
          {
            "port": 8080,
            "protocol": "TCP"
          }
        ]
      }
    ],
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "example-app"
      }
    },
    "policyTypes": [
      "Ingress"
    ]
  }
}
{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "shipkeeper",
      "app.kubernetes.io/name": "example-app"
    },
    "name": "example-app",
    "namespace": "cs-workers"
  },
  "spec": {
    "ports": [
      {
        "port": 8080,
        "protocol": "TCP",
        "targetPort": 8080
      }
    ],
    "selector": {
      "app.kubernetes.io/name": "example-app"
    },
    "type": "ClusterIP"
  }
}
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "shipkeeper",
      "app.kubernetes.io/name": "example-app"
    },
    "name": "example-app",
    "namespace": "cs-workers"
  },
  "spec": {
    "replicas": 2,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "example-app"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "shipkeeper",
          "app.kubernetes.io/name": "example-app"
        }
      },
      "spec": {
        "containers": [
          {
            "image": "lazarette.clearedstack.svc.cluster.local:5000/tools/example-app@sha256:4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a",
            "name": "example-app",
            "ports": [
              {
                "containerPort": 8080,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "tcpSocket": {
                "port": 8080
              }
            },
            "resources": {
              "limits": {
                "memory": "32Mi"
              },
              "requests": {
                "memory": "32Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            }
          }
        ],
        "securityContext": {
          "runAsNonRoot": true
        }
      }
    }
  }
}
