{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "shipkeeper",
      "app.kubernetes.io/name": "example-plane"
    },
    "name": "example-plane",
    "namespace": "clearedstack"
  },
  "spec": {
    "ingress": [],
    "podSelector": {
      "matchLabels": {
        "app.kubernetes.io/name": "example-plane"
      }
    },
    "policyTypes": [
      "Ingress"
    ]
  }
}
{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "shipkeeper",
      "app.kubernetes.io/name": "example-plane"
    },
    "name": "example-plane",
    "namespace": "clearedstack"
  },
  "spec": {
    "ports": [
      {
        "port": 9000,
        "protocol": "TCP",
        "targetPort": 9000
      }
    ],
    "selector": {
      "app.kubernetes.io/name": "example-plane"
    },
    "type": "ClusterIP"
  }
}
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "shipkeeper",
      "app.kubernetes.io/name": "example-plane"
    },
    "name": "example-plane",
    "namespace": "clearedstack"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "example-plane"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "shipkeeper",
          "app.kubernetes.io/name": "example-plane"
        }
      },
      "spec": {
        "containers": [
          {
            "image": "lazarette.clearedstack.svc.cluster.local:5000/example-plane@sha256:4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a4e7a",
            "name": "example-plane",
            "ports": [
              {
                "containerPort": 9000,
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "tcpSocket": {
                "port": 9000
              }
            },
            "resources": {
              "limits": {
                "memory": "48Mi"
              },
              "requests": {
                "memory": "48Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            }
          }
        ],
        "securityContext": {
          "runAsNonRoot": true
        }
      }
    }
  }
}
